# ABOUTME: Template for local configuration. Copy to .env and fill in. Never commit .env.
# Real LLM calls require an Anthropic API key. The test suite and CI run without one.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults live in src/outreach_agent/config.py.
OUTREACH_MODEL_OPUS=claude-opus-4-7
OUTREACH_MODEL_SONNET=claude-sonnet-4-6
OUTREACH_MODEL_HAIKU=claude-haiku-4-5

# Path to the SQLite state store. Defaults to ./outreach.db
OUTREACH_DB_PATH=outreach.db
